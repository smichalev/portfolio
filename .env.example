POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio

# Host port nginx publishes on. 8080 gets you a normal Cloudflare-proxied
# (orange cloud) setup for free — it's in Cloudflare's allowed port list.
# Any other port (e.g. 81, if 80/443 already belong to something else on
# this box, as here) still works, but: the Cloudflare DNS record must be
# "DNS only" (grey cloud) — no Cloudflare TLS for this site — and the URL
# needs the port, e.g. http://cvv.youmove.app:81. See root README.md.
NGINX_PORT=81

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Must match exactly what visitors type in the address bar — scheme,
# host and port all count. On a "DNS only" (grey cloud) Cloudflare setup
# with no TLS anywhere in the path, that's plain http:// plus the port,
# e.g. http://cvv.youmove.app:81 — not https://, there's no cert to make
# https:// work here.
CORS_ORIGIN=http://localhost

# Only "true" once this stack is actually reached over HTTPS end to end
# (Cloudflare proxied + Full/Strict, or your own TLS cert) — otherwise the
# browser silently drops the refresh_token cookie and every login/refresh
# breaks. With the "DNS only" + plain-HTTP setup above, this must stay
# "false".
COOKIE_SECURE=false
