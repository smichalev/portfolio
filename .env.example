POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:8081

# Only "true" once this stack sits behind a TLS-terminating proxy —
# otherwise the browser silently drops the refresh_token cookie and every
# login/refresh breaks. Plain `docker compose up` on port 8081 is HTTP, so
# this must stay "false" until you put HTTPS in front of it.
COOKIE_SECURE=false
