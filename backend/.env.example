PORT=4000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

CORS_ORIGIN="http://localhost:5175"

# Only set to "true" once this server sits behind TLS (HTTPS) — otherwise
# the browser silently drops the refresh_token cookie and auth breaks.
COOKIE_SECURE="false"
